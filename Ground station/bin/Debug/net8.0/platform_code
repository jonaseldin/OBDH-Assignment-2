def count_lines(lines: str) -> int:
    """
    Return the number of lines in the given text.
    """
    if not lines:
        return 0
    return len(lines.splitlines())
def TC_reply(telecommand: str) -> bool:
    """
    Takes telecommand from ground, checks the formatting, and
    rejects invalidly formatted telecommands or replies that 
    the telecommand has been accepted.

    Args:
        Telecommand line.

    Returns:
        string with acceptance or rejection of telecommand.
    """
    telecommand_word_array=telecommand.split()
    if len(telecommand_word_array) == 5: #checks if TC has 5 words
        if re.match(r"^\d{2}:\d{2}:\d{2}$",telecommand_word_array[3]) or telecommand_word_array[3]=="inst": #checks if time request format is valid
            downlink=open(r"C:\Users\wolinn-2\source\repos\Ground station\Ground station\bin\Debug\net8.0\downlink.txt", "a", encoding="utf-8")
            downlink.write("4 sequence number: "+telecommand_word_array[0]+" TC accepted \n")
            downlink.close()
            return True
        else:
            downlink=open(r"C:\Users\wolinn-2\source\repos\Ground station\Ground station\bin\Debug\net8.0\downlink.txt", "a", encoding="utf-8")
            downlink.write("4 sequence number: "+telecommand_word_array[0]+ " TC rejected: invalid time request format\n")
            downlink.close()
            return False
    else:
        downlink=open(r"C:\Users\wolinn-2\source\repos\Ground station\Ground station\bin\Debug\net8.0\downlink.txt", "a", encoding="utf-8")
        downlink.write("4 sequence number: "+telecommand_word_array[0]+ " TC rejected: invalid format\n")
        downlink.close()
        return False
