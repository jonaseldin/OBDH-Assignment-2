def PF_time(telecommand: str) -> int:

    """
    Takes telecommand with time request and converts it to seconds.

    Args:
        telecommand

    Returns:
        time request in seconds.
    """
    send_time=telecommand[4] #reads send_time from telecommand
    time_in_seconds=_time_to_seconds(send_time) #converts time request to seconds
    return time_in_seconds
def PF_time_to_string(seconds: int) -> str:
        """
        Opposite of PF_time: convert seconds to HH:MM:SS string.
        Returns None for invalid input.
        """
        try:
            total = int(seconds)
        except Exception:
            return None
        if total < 0:
            return None
        h = total // 3600
        m = (total % 3600) // 60
        s = total % 60
        return f"{h:02d}:{m:02d}:{s:02d}"
