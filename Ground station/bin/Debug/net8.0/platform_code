def TM_sequence_verify(telemetry: str,previous_telemetry_line,sequence):
    """
    Takes telemetry checks the sequence number.
    then it updates the sequence of the payload housekeeping and
    updates it with the platform telemetry sequence and writes
    the payload telemetry with the updated sequence into downlink.

    Args:
        telemetry

    Returns:
        checks the sequence.
    """
    if int(telemetry.split()[0]) == int(previous_telemetry_line.split()[0]) + 1 or int(telemetry.split()[0]) == 1: #checks if TM sequence is correct
        parts = telemetry.split() #splits telemetry into parts
        if parts: #checks if parts is not empty
            parts[0] = str(sequence)  #updates sequence number
            telemetry = " ".join(parts) #joins parts back into telemetry string
            with open(r"C:\Users\wolinn-2\source\repos\Ground station\Ground station\bin\Debug\net8.0\downlink.txt", "a", encoding="utf-8") as f: #writes updated telemetry to downlink.txt
                f.write(str(1) + " " + telemetry + "\n") #adds telemetry string and a new line
        previous_telemetry_line = telemetry #updates previous telemetry line
    else:
        downlink=open(r"C:\Users\wolinn-2\source\repos\Ground station\Ground station\bin\Debug\net8.0\downlink.txt", "a", encoding="utf-8")
        downlink.write(str(sequence)+" Payload sequence error\n" ) #writes sequence error to downlink.txt
        downlink.close()

