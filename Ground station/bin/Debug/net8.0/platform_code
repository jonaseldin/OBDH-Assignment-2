def PF_time_to_string(seconds: int) -> str:
        """
        Opposite of PF_time: convert seconds to HH:MM:SS string.
        Returns None for invalid input.
        """
        try:
            total = int(seconds)
        except Exception:
            return None
        if total < 0:
            return None
        h = total // 3600
        m = (total % 3600) // 60
        s = total % 60
        return f"{h:02d}:{m:02d}:{s:02d}"
def _time_to_seconds(timestr: str):
        try:
            h, m, s = map(int, timestr.split(":"))
            return h * 3600 + m * 60 + s
        except Exception:
            return None
